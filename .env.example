# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/zipcargo

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# ── Site ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
SITE_ORIGIN=https://zipcargo-app.onrender.com
SITE_URL=https://zipcargo-app.onrender.com

# ── Email (Brevo) ────────────────────────────────────────────────────────────
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# The FROM address for all outgoing emails (must be verified in Brevo)
BREVO_SENDER_EMAIL=info@zipcargo.com

# Where contact form submissions are forwarded (defaults to BREVO_SENDER_EMAIL)
CONTACT_NOTIFY_EMAIL=info@zipcargo.com

# ── Optional integrations ─────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
